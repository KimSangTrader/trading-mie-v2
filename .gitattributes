# Auto detect text files and normalize line endings to LF
* text=auto

# Shell scripts and Python files should use LF (Unix line endings)
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
Makefile text eol=lf
deploy.sh text eol=lf

# Windows batch files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf