[Unit]
Description=MIE V2.0 - 매매 실행(청산/피라미딩/신규진입) 자동 사이클
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/mie-v2
# 보유 포지션 청산 판정 -> 피라미딩(추가매수) 판정 -> 신규 진입 판정을 순서대로
# 실행하고, 승인된 매수/매도는 KIS 주문 API(모의투자, .env의 KIS_DEV_*)로 실제
# 주문까지 낸다. 완전자동(사람 승인 없음) - 사용자가 AskUserQuestion으로 확정한
# 설계 그대로. main.py serve(19:00 KST 일마감 분석)가 전날 밤 계산해 둔
# stock_hierarchical_scores 최신 배치를 그대로 후보 풀로 쓴다.
ExecStart=/opt/mie-v2/venv/bin/python -m market_intelligence.trade_execution.trade_execution_pipeline
StandardOutput=append:/var/log/mie-v2/trade_execution.log
StandardError=append:/var/log/mie-v2/trade_execution.log
Environment="PATH=/opt/mie-v2/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# 【2026-08-31 추가】PYTHONUNBUFFERED=1 - 로그 순서 뒤섞임 버그 수정.
# print()로 파일에 리다이렉트하면 stdout이 블록 버퍼링돼(4~8KB 또는 프로세스
# 종료 시점에만 flush) 로그 파일에 실제 실행 순서와 다르게(많이 늦게, 한꺼번에)
# 찍힌다 - 반면 logging의 기본 StreamHandler(stderr)는 즉시 flush돼서, 실제로는
# print()가 먼저 실행됐는데도 파일에는 logging 쪽이 먼저 찍히는 것처럼 보이는
# 문제가 실제 라이브 로그(2026-08-31 00:05 실행분)에서 확인됨 - "청산/피라미딩/
# 신규진입 완료" 요약 줄(logging)이 그보다 먼저 실행된 종목별 시세조회 출력
# (print)보다 로그 파일 앞쪽에 찍혀 있었음. PYTHONUNBUFFERED=1을 설정하면
# stdout도 매 줄마다 즉시 flush되어 실제 실행 순서 그대로 기록된다(디버깅
# 편의만의 문제 - 매매 판정/주문 결과 자체는 버퍼링과 무관하게 항상 정확했음).
Environment="PYTHONUNBUFFERED=1"
# 보유/후보 종목 각각 KIS 일봉 조회(get_stock_daily_chart) 1회씩 순차 호출이라
# 종목 수에 비례해 시간이 걸린다(mie-v2-valuation.service와 동일한 이유로 여유 확보).
TimeoutStartSec=1800
